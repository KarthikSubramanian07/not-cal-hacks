{
  "name": "not-cal-hacks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hackathon application portal with blind review, public OpenAPI, MCP, and CLI.",
  "license": "MIT",
  "homepage": "https://not-cal-hacks.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/not-cal-hacks.git"
  },
  "keywords": [
    "hackathon",
    "application-portal",
    "blind-review",
    "openapi",
    "mcp",
    "cloudflare-pages"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "run-p -l dev:web dev:api",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "sync:agent": "tsx --tsconfig tsconfig.worker.json scripts/sync-agent-assets.ts",
    "build": "run-s sync:agent build:client build:prerender",
    "build:client": "vite build",
    "build:prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.tsx",
    "preview": "run-s build && wrangler pages dev --port 8788",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "run-s test:unit test:api",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply not-cal-hacks --local",
    "db:migrate:remote": "wrangler d1 migrations apply not-cal-hacks --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:local": "run-s db:seed && wrangler d1 execute not-cal-hacks --local --file=./seed.generated.sql",
    "db:seed:remote": "run-s db:seed && wrangler d1 execute not-cal-hacks --remote --file=./seed.generated.sql --yes",
    "db:reset": "rm -rf .wrangler/state && run-s db:migrate:local db:seed:local",
    "deploy": "run-s build && wrangler pages deploy",
    "assets": "tsx scripts/assets.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.14",
    "lucide-react": "^1.67.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "undici": ">=7.30.1 <8",
    "sharp": "$sharp",
    "zod": "$zod",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0 <0.26"
    },
    "minimatch": "^11.0.1"
  }
}
