{
  "name": "not-cal-hacks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Legally distinct hackathon portal built purely on caffeine and hope.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "run-p -l dev:web dev:api",
    "dev:web": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "run-s build:client build:prerender",
    "build:client": "vite build",
    "build:prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.tsx",
    "preview": "run-s build && wrangler pages dev --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "run-s test:unit test:api",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply not-cal-hacks --local",
    "db:migrate:remote": "wrangler d1 migrations apply not-cal-hacks --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:local": "run-s db:seed && wrangler d1 execute not-cal-hacks --local --file=./seed.generated.sql",
    "db:seed:remote": "run-s db:seed && wrangler d1 execute not-cal-hacks --remote --file=./seed.generated.sql --yes",
    "db:reset": "rm -rf .wrangler/state && run-s db:migrate:local db:seed:local",
    "deploy": "run-s build && wrangler pages deploy",
    "assets": "tsx scripts/assets.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "happy-dom": "^16.0.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.0"
  }
}
